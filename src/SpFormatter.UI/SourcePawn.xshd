<?xml version="1.0"?>
<SyntaxDefinition name="SourcePawn" extensions=".sp;.inc" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

	<!-- Tuned for light editor surfaces -->
	<Color name="Comment" foreground="#5B7A4E" />
	<Color name="String" foreground="#A15C38" />
	<Color name="Number" foreground="#3F6B4A" />
	<Color name="Keyword" foreground="#1F5F99" fontWeight="bold" />
	<Color name="Type" foreground="#0F7A6B" />
	<Color name="Identifier" foreground="#101820" />
	<Color name="Preprocessor" foreground="#6B5B8A" />
	<Color name="Operator" foreground="#3A4654" />
	<Color name="Punctuation" foreground="#3A4654" />
	<Color name="FunctionCall" foreground="#7A5A12" />
	<Color name="Native" foreground="#1F5F99" fontWeight="bold" />

	<RuleSet>
		<Span color="Comment" begin="//" />
		<Span color="Comment" multiline="true" begin="/\*" end="\*/" />

		<Span color="String" begin="&quot;" end="&quot;">
			<RuleSet>
				<Rule color="String">\\.</Rule>
			</RuleSet>
		</Span>

		<Span color="String" begin="'" end="'">
			<RuleSet>
				<Rule color="String">\\.</Rule>
			</RuleSet>
		</Span>

		<!-- Must match at least one character; ^...$ line rules can match empty and crash AvalonEdit -->
		<Rule color="Preprocessor">#[A-Za-z_][A-Za-z0-9_]*</Rule>

		<Rule color="Number">
			\b0[xX][0-9a-fA-F]+\b|
			\b[0-9]+\.[0-9]+([eE][-+]?[0-9]+)?[fF]?\b|
			\b[0-9]+[fFlL]?\b
		</Rule>

		<Keywords color="Keyword">
			<Word>if</Word>
			<Word>else</Word>
			<Word>for</Word>
			<Word>while</Word>
			<Word>do</Word>
			<Word>switch</Word>
			<Word>case</Word>
			<Word>default</Word>
			<Word>break</Word>
			<Word>continue</Word>
			<Word>return</Word>
			<Word>public</Word>
			<Word>private</Word>
			<Word>stock</Word>
			<Word>static</Word>
			<Word>const</Word>
			<Word>new</Word>
			<Word>delete</Word>
			<Word>sizeof</Word>
			<Word>true</Word>
			<Word>false</Word>
			<Word>null</Word>
			<Word>this</Word>
		</Keywords>

		<Keywords color="Native">
			<Word>native</Word>
			<Word>forward</Word>
		</Keywords>

		<Keywords color="Type">
			<Word>void</Word>
			<Word>int</Word>
			<Word>float</Word>
			<Word>char</Word>
			<Word>bool</Word>
			<Word>any</Word>
			<Word>Handle</Word>
			<Word>Plugin</Word>
			<Word>Action</Word>
			<Word>ArrayList</Word>
			<Word>StringMap</Word>
		</Keywords>

		<Rule color="FunctionCall">
			\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()
		</Rule>

		<Rule color="Operator">
			\+\+|--|&lt;&lt;=|&gt;&gt;=|&lt;&lt;|&gt;&gt;|&lt;=|&gt;=|==|!=|&amp;&amp;|\|\||\+=|-=|\*=|/=|%=|&amp;=|\|=|\^=|[+\-*/%=!&lt;&gt;&amp;|^~]
		</Rule>

		<Rule color="Punctuation">
			[{}()\[\];,.]
		</Rule>

		<Rule color="Identifier">
			\b[A-Za-z_][A-Za-z0-9_]*
		</Rule>
	</RuleSet>
</SyntaxDefinition>
